// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum OnboardingStep {
  WELCOME
  UNITS
  MODE
  COMPLETE
}

enum OperatingMode {
  DELIVERY_CUSTOMIZATION
  CCS_RATES
}

enum CcsStatus {
  UNKNOWN
  ENABLED
  DISABLED
}

model Store {
  id                String         @id @default(cuid())
  shopDomain        String         @unique
  onboardingStep    OnboardingStep @default(WELCOME)
  mode              OperatingMode?
  appEnabled        Boolean        @default(true)
  testMode          Boolean        @default(true)
  ccsStatus         CcsStatus      @default(UNKNOWN)
  ccsModeSelectedAt DateTime?
  onboardedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  settings          StoreSettings?
  deliveryRules     DeliveryRule[]
  carrierServiceId  String?        @unique
  regions           ShippingRegion[]
  scenarios         RateScenario[]
  carrierRequests   CarrierRequest[]
}

model StoreSettings {
  id                String   @id @default(cuid())
  storeId           String   @unique
  weightUnit        String   @default("kg")
  distanceUnit      String   @default("km")
  dimensionUnit     String   @default("cm")
  volumetricDivisor Float    @default(5000)
  multipleRates     String   @default("all")
  rounding          String   @default("none")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model DeliveryRule {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  active      Boolean
  rule        Json
  revision    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

enum ShippingRegionKind {
  DOMESTIC
  CUSTOM
  REST
}

model ShippingRegion {
  id          String             @id @default(uuid())
  storeId     String
  name        String
  kind        ShippingRegionKind
  coverage    Json
  createdAt   DateTime           @default(now())
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates       FixedShippingRate[]

  @@unique([storeId, id])
  @@unique([storeId, name])
}

model RateScenario {
  id          String              @id @default(uuid())
  storeId     String
  name        String
  active      Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conditions  RateCondition[]
  rates       FixedShippingRate[]

  @@unique([storeId, id])
  @@index([storeId, active])
}

model RateCondition {
  scenarioId String
  position   Int
  condition  Json
  scenario   RateScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@id([scenarioId, position])
}

model FixedShippingRate {
  id          String         @id @default(uuid())
  storeId     String
  scenarioId  String
  regionId    String
  position    Int
  name        String
  description String
  amount      Int
  currency    String
  scenario    RateScenario   @relation(fields: [storeId, scenarioId], references: [storeId, id], onDelete: Cascade)
  region      ShippingRegion @relation(fields: [storeId, regionId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId, scenarioId])
  @@index([storeId, regionId])
}

model CarrierRequest {
  id            String   @id @default(uuid())
  storeId       String
  receivedAt    DateTime @default(now())
  country       String
  province      String?
  currency      String
  testIdentity  String
  reason        String
  rateCount     Int
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, receivedAt])
}
