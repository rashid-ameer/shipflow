{
  "name": "shipflow",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:m1": "vite-node tests/app-url.test.ts && vite-node tests/m1-persistence.test.ts && vite-node tests/market-readiness.test.ts",
    "test:markets": "vite-node tests/market-readiness.test.ts",
    "test:units": "vite-node tests/units-form-state.test.ts",
    "test:m2": "vite-node tests/shipping-settings.test.ts && vite-node tests/checkout-decision.test.ts && vite-node tests/m2-persistence.test.ts",
    "test:m3": "vite-node tests/delivery-customization.test.ts && vite-node tests/m3-persistence.test.ts",
    "test:m4": "vite-node tests/calculated-rates.test.ts && vite-node tests/m4-carrier-persistence.test.ts",
    "test:m6": "vite-node tests/cart-product-pricing.test.ts && vite-node tests/m6-pricing-persistence.test.ts",
    "test:m7": "vite-node tests/combined-rates.test.ts && vite-node tests/m7-combination-persistence.test.ts",
    "test:m8": "vite-node tests/m8-catalog-packing.test.ts",
    "test:m9": "vite-node tests/m9-live-carriers.test.ts",
    "preview:check": "node scripts/check-preview.mjs",
    "preview": "node scripts/start-preview.mjs",
    "dev": "react-router dev --host 0.0.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2",
      "effect": "^3.22.1"
    }
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  }
}
